# Default: Vite forwards /api requests to the existing FastAPI server.
BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Production alternative: an absolute API base URL (including /api).
# A cross-origin production URL must be allowed by your backend's CORS policy.
# VITE_API_BASE_URL=https://your-api.example.com/api

# Optional offline demo only. Leave unset/false to use the database.
# VITE_USE_SAMPLE_DATA=true
